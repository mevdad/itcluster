# --- Contacts shown on the page (public; leave empty until confirmed) ---
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# --- Lead delivery: configure at least one channel, otherwise the form honestly reports that it is not connected ---
# Telegram: create a bot with @BotFather, add it to the chat/channel, put the chat id here
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Generic webhook (CRM, Make, n8n, ...). Receives multipart/form-data: name, company, contact, direction, message, source, file
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=

# --- Site ---
# Canonical origin for metadata, e.g. https://h200.example
NEXT_PUBLIC_SITE_URL=
# Static build / demo switches (normally set by scripts/build-pages.mjs and the Pages workflow)
# NEXT_PUBLIC_DEMO=1            show every block with placeholders
# NEXT_PUBLIC_BASE_PATH=/repo   sub-path on github.io
# NEXT_PUBLIC_LEAD_ENDPOINT=    URL of the Cloudflare Worker (workers/lead)
# Set to 1 to expose /drafts/projects (project card templates) outside of `next dev`
SHOW_DRAFTS=
